# Colorblind friendly cycler from http://mkweb.bcgsc.ca/colorblind/

lines.linewidth : 1.5
lines.markersize : 4
axes.prop_cycle : cycler('color', [ 'cbf_dark_teal', 'cbf_purple', 'cbf_softblue', 'cbf_skyblue', 'cbf_violet', 'cbf_cyan', 'cbf_redrusset', 'cbf_peach', 'cbf_green', 'cbf_lime', 'cbf_peagreen', 'cbf_wheat' ])
axes.labelweight : heavy
axes.labelsize : 22
axes.titlesize : 22
axes.spines.top : False
axes.spines.right : False
legend.fontsize : 16
legend.frameon : False
xtick.labelsize : 16
ytick.labelsize : 16
figure.figsize : 11.0, 8.5
figure.titlesize : 22
figure.titleweight : heavy
# Force matplotlib to use type 42 (truetype) fonts, making them editable in e.g. Illustrator
pdf.fonttype : 42
ps.fonttype : 42

# For diverging colormap use RdYlBu
image.cmap : RdYlBu
