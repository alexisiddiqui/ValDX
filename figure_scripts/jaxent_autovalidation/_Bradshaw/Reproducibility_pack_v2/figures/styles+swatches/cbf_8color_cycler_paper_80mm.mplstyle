# Colorblind friendly cycler from https://jfly.uni-koeln.de/color/#pallet

lines.linewidth : 1.5
lines.markersize : 2
axes.prop_cycle : cycler('color', [ 'cbf_key', 'cbf_orange', 'cbf_sky_blue', 'cbf_bluish_green', 'cbf_yellow', 'cbf_blue', 'cbf_vermillion', 'cbf_reddish_purple' ])
axes.labelweight : heavy
axes.labelsize : 8
axes.titlesize : 10
axes.spines.top : False
axes.spines.right : False
legend.fontsize : 8
legend.frameon : False
xtick.labelsize : 8
xtick.major.size : 6
xtick.minor.size : 4
ytick.labelsize : 8
ytick.major.size : 4
ytick.minor.size : 6
# Figsize = letter aspect ratio with 80mm long edge
figure.figsize : 3.1496, 2.4338
figure.titlesize : 12
figure.titleweight : heavy
# Force matplotlib to use type 42 (truetype) fonts, making them editable in e.g. Illustrator
pdf.fonttype : 42
ps.fonttype : 42

# For diverging colormap use RdYlBu
image.cmap : RdYlBu
